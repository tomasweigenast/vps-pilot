# Required: 32 random bytes as hex (generate: openssl rand -hex 32)
COOKIE_SECRET=change_me_generate_with_openssl_rand_hex_32

# Auth mode: pam | local | both
AUTH_MODE=both

# Server listen address
LISTEN_ADDR=0.0.0.0:8080

# Directory where SQLite DB is stored
DATA_DIR=/var/lib/vps-manager

# Directory containing docker compose projects (one subdir per project)
PROJECTS_DIR=/opt/projects

# Root directory for the file browser (users cannot browse above this)
FILES_ROOT=/

# Optional TLS (leave empty to use plain HTTP behind a reverse proxy)
TLS_CERT=
TLS_KEY=
