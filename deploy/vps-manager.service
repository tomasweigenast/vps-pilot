[Unit]
Description=VPS Manager
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=vps-manager
Group=docker
EnvironmentFile=/etc/vps-manager/env
ExecStart=/usr/local/bin/vps-manager
Restart=always
RestartSec=5

# Harden
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/vps-manager

[Install]
WantedBy=multi-user.target
